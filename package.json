{
  "name": "frame-academy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n studio,render \"vite --host 0.0.0.0\" \"tsx watch server/index.ts\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "studio": "remotion studio src/remotion/index.ts",
    "render:demo": "tsx server/render-demo.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src server tests vite.config.ts",
    "format:check": "prettier --check src server tests vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@remotion/bundler": "4.0.356",
    "@remotion/cli": "4.0.356",
    "@remotion/player": "4.0.356",
    "@remotion/renderer": "4.0.356",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.356",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
